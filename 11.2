12) (Optional) Refresh Tokens — Extension Task
For lab bonus: implement refresh tokens. Idea: issue a short‑lived access token (e.g., 15m) and a long‑lived refresh token (e.g., 7d). Store refresh tokens server‑side (DB or memory for lab) to allow logout/rotation.
High-level steps: 1. On login/register, issue two tokens: accessToken (15m), refreshToken (7d). 2. Save refreshToken (mapped to user id) in memory / DB. 3. Add POST /api/auth/refresh to verify refresh token and issue a new access token. 4. Add POST /api/auth/logout to invalidate the refresh token (delete from store).
Sketch (not full code):
// in auth.routes.js
const refreshStore = new Set();

function makeRefreshToken(user) {
  const payload = { sub: user.id };
  return jwt.sign(payload, env.JWT_SECRET, { expiresIn: '7d' });
}

// on login/register
const accessToken = makeToken(user);
const refreshToken = makeRefreshToken(user);
refreshStore.add(refreshToken);
res.json({ accessToken, refreshToken });

router.post('/refresh', (req, res) => {
  const { refreshToken } = req.body;
  if (!refreshToken || !refreshStore.has(refreshToken)) return res.status(401).json({ error: 'Invalid refresh token' });
  try {
    const payload = jwt.verify(refreshToken, env.JWT_SECRET);
    const user = users.find(u => u.id === payload.sub);
    if (!user) return res.status(404).json({ error: 'User not found' });
    const accessToken = makeToken(user);
    return res.json({ accessToken });
  } catch {
    return res.status(401).json({ error: 'Expired/invalid refresh token' });
  }
});

router.post('/logout', (req, res) => {
  const { refreshToken } = req.body;
  refreshStore.delete(refreshToken);
  res.json({ message: 'Logged out' });
});
